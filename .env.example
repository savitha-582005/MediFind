# Copy to .env and replace placeholders locally. Never commit .env.
MONGO_USERNAME=your_atlas_database_username
MONGO_PASSWORD=your_atlas_database_password
MONGO_CLUSTER=your-cluster.mongodb.net
SECRET_KEY=replace_with_a_random_secret_generated_locally
SESSION_COOKIE_SECURE=false
GOOGLE_MAPS_API_KEY=restricted_browser_key_from_google_cloud
GEOCODER_CONTACT=project_contact_email_for_nominatim
